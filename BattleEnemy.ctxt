#BlueJ class context
comment0.target=BattleEnemy
comment0.text=\r\n\ BattleEnemy\ -\ an\ enemy\ on\ the\ card-battle\ screen.\ It\ draws\ its\ own\ body,\ its\ next\r\n\ move\ (the\ "intent"),\ health,\ block,\ boss\ shield\ and\ the\ yellow\ MARK\ badge,\ and\r\n\ follows\ the\ attack\ pattern\ given\ by\ its\ EnemyType.\r\n\r\n\ Damage\ goes\ through\ three\ layers,\ in\ this\ order\:\r\n\ \ \ 1.\ BLOCK\ \ (from\ its\ own\ Defend\ moves)\ \ 2.\ SHIELD\ (bosses\ only)\ \ 3.\ HEALTH\r\n
comment1.params=type\ startIndex
comment1.target=BattleEnemy(EnemyType,\ int)
comment10.params=
comment10.target=void\ stun()
comment10.text=Make\ the\ enemy\ skip\ its\ next\ action\ (used\ by\ the\ Bayangan\ glyph).
comment11.params=amount\ strong
comment11.target=int\ takeDamage(int,\ boolean)
comment11.text=\r\n\ @param\ strong\ true\ for\ KOMBO\ hits\ and\ glyph\ powers\:\ they\ hit\ a\ boss\ shield\ at\ full\ strength\r\n\ @return\ the\ damage\ that\ actually\ reached\ the\ HEALTH\ (after\ block\ and\ shield)\r\n
comment12.params=world
comment12.target=void\ takeTurn(BattleWorld)
comment12.text=Carry\ out\ the\ current\ intent,\ then\ move\ on\ to\ the\ next\ one\ in\ the\ pattern.
